# Copy this file to .env for local development. The Makefile targets load it
# through python-dotenv so migrations, seeding, development, and tests behave
# consistently.
# Never commit real credentials or production paths.
WIKI_PARCHINO_DATABASE_URL=sqlite:///./wiki_parchino.db
WIKI_PARCHINO_MEDIA_DIR=./media
# Comma-separated browser origins. Origins never include a path or trailing slash.
WIKI_PARCHINO_FRONTEND_ORIGINS=http://127.0.0.1:5173
WIKI_PARCHINO_FRONTEND_URL=http://127.0.0.1:5173
WIKI_PARCHINO_SESSION_DAYS=3
# Public reverse-proxy prefix. Keep empty when FastAPI is served at the domain root.
WIKI_PARCHINO_ROOT_PATH=
# Optional outbound-only Telegram maintenance notifications.
WIKI_PARCHINO_TELEGRAM_BOT_TOKEN=
WIKI_PARCHINO_TELEGRAM_CHAT_ID=
